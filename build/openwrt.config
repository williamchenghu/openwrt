# Committed OpenWrt configuration for the WR703N print-gateway image.
#
# This is a *delta on top of `make defconfig`*: build.sh runs
#   make defconfig            # correct baseline for the selected target
#   apply this file           # our device + package toggles
#   make defconfig            # normalize + resolve dependencies
#
# It intentionally contains only the decisions that differ from OpenWrt's
# defaults, so it stays readable and survives kernel/package churn. Feed-fed
# package symbols resolve only after `./scripts/feeds install -a` on the build
# host (that is why this is not a full generated .config).

# --- Target: ath79 / subtarget tiny / device TL-WR703N ----------------------
CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_tiny=y
CONFIG_TARGET_ath79_tiny_DEVICE_tplink_tl-wr703n=y

# --- Root filesystem: squashfs (default; stated explicitly) ------------------
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# --- Kernel modules (devices/enablers) --------------------------------------
CONFIG_PACKAGE_kmod-usb2=y                 # USB 2.0 (EHCI) host for the printer
CONFIG_PACKAGE_kmod-usb-printer=y          # /dev/usb/lp0 (usblp)
# kmod-usb-chipidea2 comes from the device's DEVICE_PACKAGES automatically.

# --- Printer stack (ticket #4): raw TCP 9100 pass-through --------------------
CONFIG_PACKAGE_p910nd=y

# --- Full admin UI (map scope amendment) -------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-p910nd=y           # printer status page

# --- SSH (base default dropbear; pin explicitly) -----------------------------
CONFIG_PACKAGE_dropbear=y

# --- WiFi client (base defaults for the AR9331 wmac; pin explicitly) ---------
CONFIG_PACKAGE_kmod-ath9k=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y        # station (client) support

# --- Disable out-of-scope local services (ticket #6) -------------------------
# No local DHCP/DNS: the gateway is a pure client of the upstream router.
# Note: the default DHCPv6 server package is `odhcpd-ipv6only`, not `odhcpd` —
# both must be disabled (verified against a generated .config).
CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_odhcpd=n
CONFIG_PACKAGE_odhcpd-ipv6only=n